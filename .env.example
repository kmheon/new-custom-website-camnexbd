# =============================================================================
# CamneX Platform Environment Variables Template
# Copy this file to .env and replace placeholders with production values.
# =============================================================================

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Initial Administrator Credentials (required on first launch)
# Password will be securely hashed with bcrypt upon database initialization.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_this_to_a_strong_random_password

# Database Settings (optional override, defaults to ./camnex.db)
DATABASE_PATH=./camnex.db

# Session & Security Settings
SESSION_SECRET=generate_a_random_64_character_hex_secret
