# =============================================================================
# CamneX Platform Environment Variables Template
# Copy this file to .env and replace placeholders with production values.
# =============================================================================

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Initial Administrator Credentials (required on first launch)
# Password will be securely hashed with bcrypt upon database initialization.
ADMIN_EMAIL=admin@camnexbd.com
ADMIN_PASSWORD=change_this_to_a_strong_random_password

# Database Settings (optional override, defaults to ./camnex.db)
DATABASE_PATH=./camnex.db

# Session & Security Settings
SESSION_SECRET=generate_a_random_64_character_hex_secret

# Canonical Site URL (used for OAuth redirect callbacks)
SITE_URL=http://localhost:3000

# =============================================================================
# Google OAuth 2.0 / OpenID Connect (Customer Authentication)
# Obtain credentials from Google Cloud Console (APIs & Services > Credentials):
# Authorized redirect URI: https://yourdomain.com/api/auth/oauth/google/callback
# =============================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# Sign in with Apple (Customer Authentication)
# Obtain credentials from Apple Developer Portal (Certificates, Identifiers & Profiles):
# Authorized return URL: https://yourdomain.com/api/auth/oauth/apple/callback
# =============================================================================
APPLE_CLIENT_ID=com.yourdomain.client
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGTAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBHkwdwIBAQQg...\n-----END PRIVATE KEY-----"

# =============================================================================
# SMS OTP Gateway (Customer Phone Verification)
# Supported providers: greenweb, mimsms, twilio
# Set SMS_GATEWAY_PROVIDER=disabled to disable phone OTP
# =============================================================================
SMS_GATEWAY_PROVIDER=disabled
SMS_API_KEY=your_sms_gateway_api_key_or_token
SMS_SENDER_ID=CamneX
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# =============================================================================
# Email Verification & Transactional Notifications (cPanel / SMTP Delivery)
# Official automated notifications mailbox: noreply@camnexbd.com
# Use port 465 (SSL) or 587 (TLS) with your cPanel mail credentials
# =============================================================================
SMTP_HOST=mail.camnexbd.com
SMTP_PORT=465
SMTP_USER=noreply@camnexbd.com
SMTP_PASS=your_cpanel_mailbox_password
SMTP_FROM="CamneX Bangladesh <noreply@camnexbd.com>"

# =============================================================================
# Lightweight CAPTCHA / Bot Protection (Cloudflare Turnstile)
# Obtain keys from Cloudflare Dashboard (Turnstile > Add site):
# Always-pass testing keys:
# Site Key: 1x00000000000000000000AA
# Secret Key: 1x0000000000000000000000000000000AA
# =============================================================================
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
